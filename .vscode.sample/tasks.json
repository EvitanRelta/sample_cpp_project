{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Linux Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "linux-debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Linux Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Linux Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Build Windows MSVC Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\build_vs2022.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
